[Unit]
Description=Ocypus Iota A62 CPU temperature display for %i
After=systemd-udevd.service

[Service]
Type=simple
User=%i
SupplementaryGroups=ocypus-a62
ExecStart=/usr/local/libexec/ocypus_a62.py watch
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
